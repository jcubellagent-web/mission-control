<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.jaimes.telegram-fast-ack</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/jc_agent/.local/bin/python3.11</string>
    <string>/Users/jc_agent/.openclaw/workspace/mission-control/scripts/jaimes_telegram_fast_ack_launcher.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/jc_agent/.openclaw/workspace/mission-control</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/jc_agent</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>JAIMES_TELEGRAM_LIVE_CARDS</key>
    <string>1</string>
    <key>JAIMES_TELEGRAM_TASK_HEADERS</key>
    <string>1</string>
    <key>JAIMES_TELEGRAM_TYPING_ACTIONS</key>
    <string>1</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/jc_agent/.openclaw/workspace/logs/jaimes_telegram_fast_ack.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jc_agent/.openclaw/workspace/logs/jaimes_telegram_fast_ack.launchd.err</string>
</dict>
</plist>
