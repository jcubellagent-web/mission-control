<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.jaimes.capability-upgrade-sweep</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/jc_agent/.openclaw/workspace &amp;&amp; /opt/homebrew/bin/python3 mission-control/scripts/capability_inventory.py --node jaimes-via-josh --agent jaimes --merge &amp;&amp; /opt/homebrew/bin/python3 mission-control/scripts/capability_watch.py --publish --agent jaimes &amp;&amp; /opt/homebrew/bin/python3 mission-control/scripts/update_mission_control.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/jc_agent/.openclaw/workspace</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/jc_agent/.openclaw/workspace/logs/jaimes_capability_upgrade_sweep.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jc_agent/.openclaw/workspace/logs/jaimes_capability_upgrade_sweep.launchd.err</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
