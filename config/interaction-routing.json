{
  "version": 3,
  "semanticOrder": [
    "connector-or-api",
    "browser-dom",
    "accessibility",
    "vision",
    "coordinates"
  ],
  "hosts": {
    "josh2": {
      "role": "visible",
      "label": "Josh 2.0",
      "browserSurface": "codex-browser",
      "desktopSurface": "codex-computer-use",
      "displayLeaseRequired": true,
      "headlessCdpRequired": false
    },
    "jaimes": {
      "role": "headless",
      "label": "JAIMES",
      "browserSurface": "cdp-playwright",
      "desktopSurface": "cua-driver",
      "displayLeaseRequired": false,
      "headlessCdpRequired": true
    },
    "joshex": {
      "role": "private",
      "label": "JOSHeX",
      "browserSurface": "codex-browser",
      "desktopSurface": "codex-computer-use",
      "displayLeaseRequired": false,
      "headlessCdpRequired": false
    }
  },
  "personalMacFallback": {
    "personalHost": "joshex",
    "defaultVisibleHost": "josh2",
    "backgroundHost": "jaimes",
    "requireExplicitAcknowledgement": true,
    "allowedReasons": [
      "private-browser-session",
      "personal-account",
      "keychain",
      "oauth",
      "local-file",
      "macbook-only-app"
    ]
  },
  "sessionEngine": {
    "enabled": true,
    "maxAttempts": 3,
    "commandTimeoutSeconds": 45,
    "operatorPollMilliseconds": 100,
    "terminateGraceSeconds": 2,
    "verificationRequired": true,
    "defaultExpectation": "changed",
    "autoPromoteHeadlessFailure": true,
    "promotionHost": "josh2",
    "promotionTransport": "pull-broker",
    "promotionPollSeconds": 5,
    "promotionRequestTtlSeconds": 120,
    "promotionReasons": [
      "driver-down",
      "semantic-miss",
      "verification-failed",
      "visual-state-required"
    ],
    "targetResolution": {
      "minimumConfidence": 0.62,
      "ambiguityMargin": 0.03,
      "coordinateFallback": true,
      "sourceOrder": [
        "browser-dom",
        "accessibility",
        "vision",
        "coordinates"
      ]
    },
    "receipts": {
      "metadataOnly": true,
      "stateTokensShared": false,
      "commandOutputShared": false,
      "contentFieldsShared": false
    }
  },
  "privacy": {
    "dashboardSafeOnly": true,
    "screenshotsInSharedTelemetry": false,
    "pageTextInSharedTelemetry": false,
    "urlsInSharedTelemetry": false,
    "selectorsInSharedTelemetry": false,
    "accessibilityTreesInSharedTelemetry": false,
    "credentialsInSharedTelemetry": false
  }
}
