# 1Password op:// references for the JAIMES Hermes gateway.
# Hermes has dedicated OpenRouter and Telegram credentials; the remaining
# shared integrations resolve from the Agent Ecosystem vault. Store references only.
OPENROUTER_API_KEY=op://Agent Ecosystem/OpenRouter JAIMES Hermes/credential
XAI_API_KEY=op://Agent Ecosystem/xAI/API key
GEMINI_API_KEY=op://Agent Ecosystem/Gemini/API key
OPENAI_API_KEY=op://Agent Ecosystem/OpenAI/API key
TELEGRAM_BOT_TOKEN=op://Agent Ecosystem/Telegram JAIMES Hermes Bot/credential
CONTROL_TOWER_SHARED_SECRET=op://Agent Ecosystem/Control Tower/shared secret
