{
  "schemaVersion": 1,
  "primarySecretStore": "1password",
  "principle": "use-without-reveal",
  "hosts": {
    "josh2": {
      "owners": ["josh2"],
      "serviceAccount": "host-scoped-read-only-keychain",
      "runner": "scripts/op_agent_env.sh"
    },
    "jaimes": {
      "owners": ["jaimes", "jain"],
      "serviceAccount": "host-scoped-read-only-keychain",
      "runner": "scripts/op_agent_env.sh"
    },
    "joshex": {
      "owners": ["joshex"],
      "serviceAccount": "none",
      "route": "coordinate-on-owning-mac-mini-or-use-intentional-signed-in-1password-session"
    }
  },
  "allowedRoutes": [
    "checked-in-op-reference-profile-to-intended-child-environment",
    "checked-in-application-specific-secret-broker",
    "host-local-authenticated-browser-session",
    "allowlisted-exact-origin-mfa-injection"
  ],
  "authorization": {
    "ordinaryExpected1PasswordCliAccess": "verify-and-authorize-within-two-seconds",
    "requireProcessAccountHostAndPurposeMatch": true
  },
  "humanGates": [
    "password-change",
    "account-recovery",
    "passkey-or-mfa-enrollment",
    "security-factor-removal-or-replacement",
    "wallet-or-payment-signing",
    "purchase-or-transfer",
    "permission-expansion",
    "public-or-irreversible-action"
  ],
  "forbidden": [
    "secret-in-model-context",
    "secret-in-shared-memory-or-brain-feed",
    "secret-in-command-argument-or-clipboard",
    "secret-in-file-or-log",
    "process-environment-inspection",
    "printenv-secret-capture",
    "cookie-or-session-export"
  ],
  "telemetry": [
    "capability",
    "owningHost",
    "purpose",
    "authorizationOutcome",
    "result",
    "latencyMs"
  ]
}
