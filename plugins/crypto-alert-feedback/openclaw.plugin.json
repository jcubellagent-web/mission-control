{
  "id": "crypto-alert-feedback",
  "name": "Crypto Alert Feedback",
  "description": "Captures fire/ice feedback and optional reasons for Topic 20 crypto alerts.",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "chatId": { "type": "string" },
      "threadId": { "type": "string" },
      "pendingPath": { "type": "string" },
      "ledgerPath": { "type": "string" },
      "learningPath": { "type": "string" },
      "outboxPath": { "type": "string" },
      "pendingTtlSeconds": { "type": "number", "minimum": 60, "maximum": 604800 },
      "maxReasonChars": { "type": "number", "minimum": 1, "maximum": 4000 }
    }
  },
  "activation": { "onStartup": true }
}
