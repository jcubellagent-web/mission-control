{
  "id": "inbox-coordinator",
  "name": "Inbox Coordinator",
  "description": "Claims untagged Josh 2.0 Inbox messages and dispatches one private asynchronous worker.",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "registryPath": { "type": "string" },
      "pythonPath": { "type": "string" },
      "helperPath": { "type": "string" },
      "claimDir": { "type": "string" },
      "helperTimeoutMs": { "type": "number", "minimum": 1, "maximum": 12000 }
    }
  },
  "activation": {
    "onStartup": true
  }
}
