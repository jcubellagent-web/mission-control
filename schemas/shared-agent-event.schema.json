{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mission-control.local/schemas/shared-agent-event.schema.json",
  "title": "Shared Agent Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workId",
    "runId",
    "generation",
    "sequence",
    "time",
    "agent",
    "type",
    "title",
    "status",
    "privacy",
    "originClaimHash"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 120
    },
    "workId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "agent": {
      "type": "string",
      "enum": ["josh", "josh2", "jaimes", "jain", "joshex"]
    },
    "agentLabel": {
      "type": "string",
      "maxLength": 80
    },
    "type": {
      "type": "string",
      "enum": ["status", "job", "decision", "handoff", "blocked", "complete", "note"]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "status": {
      "type": "string",
      "enum": ["accepted", "planned", "routed", "active", "verifying", "ready", "done", "blocked", "error", "cancelled", "info"]
    },
    "tool": {
      "type": "string",
      "maxLength": 80
    },
    "detail": {
      "type": "string",
      "maxLength": 500
    },
    "phase": {
      "type": "string",
      "maxLength": 120
    },
    "origin": {
      "type": "string",
      "maxLength": 80
    },
    "originClaimHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "modelFamily": {
      "type": ["string", "null"],
      "enum": ["codex", "antigravity", "ollama", "grok", null]
    },
    "modelId": {
      "type": ["string", "null"],
      "maxLength": 120
    },
    "routeVerified": {
      "type": "boolean"
    },
    "leaseUntil": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "privacy": {
      "type": "string",
      "enum": ["dashboard-safe", "agent-private", "josh-only"]
    },
    "links": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url"],
        "properties": {
          "label": {"type": "string", "maxLength": 80},
          "url": {"type": "string", "maxLength": 300}
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    }
  }
}
